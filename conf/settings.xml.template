<?xml version="1.0" encoding="UTF-8"?>
<settings>
	<proxies>
		<proxy>
			<id>hp-proxy</id>
			<active>true</active>
			<protocol>http</protocol>
			<host>web-proxy.corp.hpecorp.net</host>
			<port>8080</port>
			<!-- Must cover BOTH internal Nexus hosts (df-mvn-dev and df-mvn-stage);
			     routing df-mvn-stage through web-proxy returns 504 and fails dependency resolution. -->
			<nonProxyHosts>*.ftc.hcocto.hpecorp.net</nonProxyHosts>
		</proxy>
		<proxy>
			<id>drill-proxy</id>
			<active>true</active>
			<protocol>https</protocol>
			<host>web-proxy.corp.hpecorp.net</host>
			<port>8080</port>
			<nonProxyHosts>s3-us-west-1.amazonaws.com</nonProxyHosts>
		</proxy>
	</proxies>
</settings>